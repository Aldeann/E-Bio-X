MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_DATABASE=e_bio

FRONTEND_URL=[your frontend url]

SECRET_KEY=[your secret key]

API_KEY=[your api key from console developer]
GOOGLE_CLIENT_ID=[your google client id from console developer]


# ---- Supabase Storage (private bucket, production target) ----
# STORAGE_PROVIDER=supabase  -> uploads go to Supabase Storage
# STORAGE_PROVIDER=r2        -> rollback: Cloudflare R2 (needs R2_* vars)
# STORAGE_PROVIDER=local     -> dev fallback, writes to uploads/ only
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://[your-project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[service-role secret - backend only, never expose]
SUPABASE_STORAGE_BUCKET=e-bio-x-materials
SUPABASE_SIGNED_URL_EXPIRES=7200

# ---- Rollback only: Cloudflare R2 (remove after Supabase is live) ----
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=[your cloudflare account id]
# R2_BUCKET=[your r2 bucket name]
# R2_ACCESS_KEY_ID=[your r2 access key id]
# R2_SECRET_ACCESS_KEY=[your r2 secret access key]
