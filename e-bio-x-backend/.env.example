MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_DATABASE=e_bio

FRONTEND_URL=[your frontend url]

SECRET_KEY=[your secret key]

API_KEY=[your api key from console developer]
GOOGLE_CLIENT_ID=[your google client id from console developer]

STORAGE_PROVIDER=r2



# ---- Cloudflare R2 object storage (private bucket) ----
# STORAGE_PROVIDER=r2  -> uploads go to R2 (production)
# STORAGE_PROVIDER=local -> dev fallback, writes to uploads/ only
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=[your cloudflare account id]
R2_BUCKET=[your r2 bucket name]
R2_ACCESS_KEY_ID=[your r2 access key id]
R2_SECRET_ACCESS_KEY=[your r2 secret access key]
R2_PRESIGN_EXPIRES=7200
